<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	
	<include resource="org/springframework/boot/logging/logback/base.xml" />

	<!--
		Envio para o Loggly. Ficava atrelado ao perfil "production", mas sem um
		token o endpointUrl fica malformado e o appender loga um erro de 403 a
		cada poucos centenas de milissegundos, inundando a saída. Agora é um
		perfil próprio: ative "production,loggly" e informe LOGGLY_TOKEN.
	-->
	<springProfile name="loggly">
		<springProperty name="logglyToken" source="logging.loggly.token" />
			
		<appender name="loggly" class="ch.qos.logback.ext.loggly.LogglyAppender">
			<endpointUrl>https://logs-01.loggly.com/inputs/${logglyToken}/tag/logback</endpointUrl>
			<pattern>%d{"ISO8601", UTC} %p %t %c %M - %m%n</pattern>
		</appender>
		
		<appender name="logglyAsync" class="ch.qos.logback.classic.AsyncAppender">
			<appender-ref ref="loggly" />
		</appender>
	  	
	  	<root level="info">
	    	<appender-ref ref="logglyAsync" />
	  	</root>
  	</springProfile>
</configuration>