meta {
  name: Token - client_credentials (faturamento)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{faturamentoClientId}}
  password: {{faturamentoClientSecret}}
}

body:form-urlencoded {
  grant_type: client_credentials
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessTokenFaturamento", res.getBody().access_token);
  }
}

docs {
  Fluxo máquina-a-máquina. O `AlgaFoodTokenCustomizer` lê a setting
  `CLIENT_AUTHORITIES_SETTING` do client e injeta `CONSULTAR_PEDIDOS` e
  `GERAR_RELATORIOS` como authorities — não há usuário no token.

  Guarda o token em `{{accessTokenFaturamento}}`. Use-o sobrescrevendo o header
  `Authorization` numa requisição (ver *Estatísticas → Vendas diárias*).

  Defina `faturamentoClientSecret` no ambiente (valor da massa: `faturamento123`).
}
