meta {
  name: Adicionar usuário
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Manolo Cicrano Fulano da Silva",
    "email": "manolo@email.com",
    "senha": "toor123"
  }
}

assert {
  res.status: eq 201
}

docs {
  `@CheckSecurity.UsuariosGruposPermissoes.PodeEditar`

  `UsuarioComSenhaInput`. E-mail duplicado devolve 409.
}
