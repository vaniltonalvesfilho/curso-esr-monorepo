meta {
  name: Inativar múltiplos
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/v1/restaurantes/ativacoes
  body: json
  auth: inherit
}

body:json {
  [
    1,
    2
  ]
}

assert {
  res.status: eq 204
}

docs {
  DELETE com corpo — alguns proxies descartam o body; se der 400 atrás do nginx, é isso.
}
