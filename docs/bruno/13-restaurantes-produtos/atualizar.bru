meta {
  name: Atualizar produto
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/restaurantes/{{restauranteId}}/produtos/{{produtoId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Prime Rib",
    "descricao": "Especialidade da casa",
    "preco": 42.00,
    "ativo": true
  }
}

assert {
  res.status: eq 200
}
