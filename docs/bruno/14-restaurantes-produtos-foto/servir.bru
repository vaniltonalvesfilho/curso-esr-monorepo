meta {
  name: Baixar a imagem
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/restaurantes/{{restauranteId}}/produtos/{{produtoId}}/foto
  body: none
  auth: inherit
}

headers {
  Accept: image/jpeg
}

docs {
  Com `algafood.storage.tipo=local` devolve os bytes; com `s3`, um 302 para a URL do bucket.
}
