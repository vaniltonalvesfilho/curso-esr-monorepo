# Trava de segurança de supply chain — ver docs/SEGURANCA-FRONTEND.md
#
# Não executa preinstall/postinstall de nenhuma dependência. É o vetor usado
# pelas campanhas Shai-Hulud/ChainDrop para roubar credenciais na instalação.
ignore-scripts=true

# Só instala versões publicadas há mais de 7 dias. Uma release comprometida
# costuma ser detectada e despublicada em horas; a carência evita a janela cega.
min-release-age=7

# Falha a instalação se houver vulnerabilidade alta ou crítica conhecida.
audit=true
audit-level=high

fund=false
